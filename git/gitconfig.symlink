# vim: set filetype=gitcommit: 
[core]
	excludesfile = ~/.gitignore
[include]
	path = ~/.gitconfig.local
[push]
	default = simple
[color]
	ui = true
[alias]
	new = switch -c
	b = branch
	bs = branch --show-current
	c = commit
	l = log --oneline
	ll = log
	out = checkout
	p = push
	pnv =  push --no-verify
	pfwl = push --force-with-lease
	pf = push --force
	squash = rebase -i HEAD~2
	s = status --short
	ss = status
	sync = fetch --all --prune
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[rerere]
	enabled = true
