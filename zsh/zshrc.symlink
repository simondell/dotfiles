# your project folder that we can `c [tab]` to
export PROJECTS=$HOME/Developer

# Canonical install location: DOTFILES_ROOT. ~/.localrc wins when it exists
# (the repo may live anywhere); this fallback covers fresh machines before
# bootstrap and unset-variable shells.
: ${DOTFILES_ROOT:="$PROJECTS/dotfiles"}
# $ZSH kept as a deprecated alias so old scripts keep working; retire them
# gradually to $DOTFILES_ROOT (see system/path.zsh history).
export ZSH=$DOTFILES_ROOT

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
echo "Checking $HOME/.localrc"
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($DOTFILES_ROOT/**/*.zsh)

# reset the path to a sane default
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
echo "Configuring topics"
for file in ${${${config_files:#*/path.zsh}:#*/completion.zsh}:#*/_path.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -Uz compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files
#test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# use zmv
autoload -U zmv
[ -f "$HOME/.ghcup/env" ] && . "$HOME/.ghcup/env" # ghcup-env